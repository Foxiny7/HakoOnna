# 文本文件统一换行
* text=auto

# Unity 序列化文件（YAML），按文本处理
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.meta       text eol=lf
*.controller text eol=lf
*.anim       text eol=lf
*.cs         text diff=csharp

# 二进制文件：不做换行转换、不做文本对比
# 说明：目前不使用 Git LFS（GitHub 账号的 LFS 额度已用完）。
# GitHub 拒收单个超过 100 MB 的文件；以后有大模型或大贴图时再考虑 LFS 或其他存储。
*.fbx    binary
*.obj    binary
*.blend  binary
*.glb    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.tga    binary
*.tif    binary
*.tiff   binary
*.psd    binary
*.exr    binary
*.hdr    binary
*.wav    binary
*.mp3    binary
*.ogg    binary
*.mp4    binary
